  "linker_script": "kraken_ui2.ld",
  "entry": "krk_ext_screens",
  "expect_entry": "0x030ee000",
  "imports": [
   {"from": "kraken_ui"},
   {"from": "kraken_ui", "syms": ["krk_screen_owner", "krk_tags_shown", "krk_popup", "krk_popup_draw", "krk_key_scan", "krk_opt_enter", "krk_opt_commit", "krk_run_screen"]},
   {"from": "kraken_ui3", "syms": ["krk_sat_screen", "krk_sat_tick", "krk_callsign_screen", "krk_call_get", "krk_rec_csum", "krk_aprs_cfg_path", "krk_aprs_cfg_set_path", "krk_cwid_cfg", "krk_cwid_cfg_set", "krk_sat_active", "krk_tap_key", "krk_edit_ram", "krk_aprs_text_load", "krk_aprs_text_store", "krk_aprs_text_cat"]}
  ],
  "libgcc": true
 },
 {
