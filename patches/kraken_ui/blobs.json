{
 "_comment": [
  "Blobs of kraken_ui.patch.json. tools/gen_manifest.py expands this into the manifest's \"blobs\": the shared compiler/linker flags",
  "come from defaults (opt = the optimisation level, replaced per blob), and each blob's defsym is built from its imports.",
  "exports = the symbols a blob offers the others (every blob that imports the whole blob gets all of them);",
  "imports[] = {from: blob, syms: [..]} for named symbols, or {from: blob, except: [..]} for all of its exports minus those it does not use."
 ],
 "defaults": {
  "opt": "-O2",
  "cflags": ["-Wall", "-ffreestanding", "-fno-tree-loop-distribute-patterns", "-ffunction-sections", "-fdata-sections"],
  "ldflags": ["--gc-sections"]
 },
 "blobs": [
 {
  "name": "kraken_ui",
  "sources": ["krk_core.c", "krk_about.c", "krk_rssi.c", "krk_grid.c", "krk_lastheard.c", "krk_rf.c", "krk_scope.c", "krk_optrow.c", "krk_stubs.S"],
  "linker_script": "kraken_ui.ld",
  "entry": "krk_item_ok",
  "expect_entry": "0x030e4000",
  "exports": ["krk_line", "krk_text", "krk_cat", "krk_catn", "krk_cati", "krk_catfix", "krk_pad", "krk_line_cached", "krk_fmt_age", "krk_uart_putc", "krk_uart_puts", "krk_hex", "krk_itoa", "krk_gps_get", "krk_channel_analog", "krk_channel_side", "krk_channel_flags", "krk_channel_mode", "krk_channel_freq", "krk_channel_on_selected", "krk_list_cells"]
 },
 {
  "name": "kraken_ui3",
